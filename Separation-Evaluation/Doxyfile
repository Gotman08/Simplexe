# Doxyfile pour Simplexe — Separation & Evaluation
# Configuration minimale : génère uniquement la documentation HTML
# à partir des sources C (include/ et src/).

PROJECT_NAME           = "Simplexe — Séparation & Évaluation"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Résolution de TSP et UKP par Branch & Bound (C11 + GLPK)"

OUTPUT_DIRECTORY       = doc
OUTPUT_LANGUAGE        = French
INPUT                  = include src
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8

# Cible C uniquement
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTENSION_MAPPING      = h=C

# Extraction : on documente uniquement les éléments commentés
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Conventions de commentaire
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

# Avertissements (utile pour repérer les oublis)
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = doc/doxygen-warnings.log

# Génération
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html

# Présentation
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
ALPHABETICAL_INDEX     = YES

# Diagrammes (désactivés pour éviter la dépendance à Graphviz)
HAVE_DOT               = NO

QUIET                  = YES
